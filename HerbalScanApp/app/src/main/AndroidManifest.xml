<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HerbalScan"
        tools:targetApi="31">
        
        <!-- Splash Screen Activity -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.HerbalScan.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Login Activity -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Register Activity -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Main Activity (Home) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />
        
        <!-- Scan Activity -->
        <activity
            android:name=".ui.scan.ScanActivity"
            android:exported="false" />
        
        <!-- Result Activity -->
        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false" />
        
        <!-- Herbal List Activity -->
        <activity
            android:name=".ui.herbal.HerbalListActivity"
            android:exported="false" />
        
        <!-- Herbal Detail Activity -->
        <activity
            android:name=".ui.herbal.HerbalDetailActivity"
            android:exported="false" />
        
        <!-- Profile Activity -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />
        
        <!-- History Activity -->
        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false" />
        
        <!-- Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
            
    </application>

</manifest>
